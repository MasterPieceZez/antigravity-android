<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/agy_sheet_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Drag handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@color/agy_border" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/agy_control_center_title"
            android:textColor="@color/agy_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Live Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/agy_card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot_engine"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/agy_dot_off" />

                <TextView
                    android:id="@+id/txt_status_engine"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/agy_status_engine_checking"
                    android:textColor="@color/agy_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot_hub"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/agy_dot_off" />

                <TextView
                    android:id="@+id/txt_status_hub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/agy_status_hub_checking"
                    android:textColor="@color/agy_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot_datasaver"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/agy_dot_ok" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/agy_status_data_saver"
                    android:textColor="@color/agy_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Multi-Account & Auto-Switch -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/agy_section_accounts"
            android:textColor="@color/agy_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/agy_card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_active_account"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/agy_active_account_checking"
                    android:textColor="@color/agy_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sheet_btn_add_account"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/agy_btn_primary"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="@string/agy_btn_add_account"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sheet_accounts_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <Switch
                android:id="@+id/switch_auto_switch_quota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:checked="true"
                android:text="@string/agy_switch_auto_quota"
                android:textColor="@color/agy_text_primary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/switch_region_bypass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="false"
                android:text="@string/agy_switch_region_bypass"
                android:textColor="@color/agy_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Language & BiDi / فارسی -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/agy_section_language_bidi"
            android:textColor="@color/agy_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/agy_card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <Switch
                android:id="@+id/switch_bidi_rtl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/agy_switch_smart_bidi"
                android:textColor="@color/agy_text_primary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/switch_persian_ui"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="false"
                android:text="@string/agy_switch_persian_ui"
                android:textColor="@color/agy_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Quick Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/agy_section_quick_actions"
            android:textColor="@color/agy_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sheet_btn_reload"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/agy_btn_secondary"
                android:gravity="center"
                android:text="@string/agy_btn_reload_ui"
                android:textColor="@color/agy_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sheet_btn_restart"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/agy_btn_secondary"
                android:gravity="center"
                android:text="@string/agy_btn_restart_hub"
                android:textColor="@color/agy_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sheet_btn_terminal"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/agy_btn_secondary"
                android:gravity="center"
                android:text="@string/agy_btn_builtin_terminal"
                android:textColor="@color/agy_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sheet_btn_logs"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/agy_btn_secondary"
                android:gravity="center"
                android:text="@string/agy_btn_view_logs"
                android:textColor="@color/agy_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sheet_btn_clear_cache"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/agy_btn_secondary"
                android:gravity="center"
                android:text="@string/agy_btn_clear_cache"
                android:textColor="@color/agy_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sheet_btn_check_update"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/agy_btn_secondary"
                android:gravity="center"
                android:text="@string/agy_btn_check_updates"
                android:textColor="@color/agy_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/sheet_btn_reinstall_cli"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/agy_btn_secondary"
            android:gravity="center"
            android:text="@string/agy_btn_reinstall_cli"
            android:textColor="@color/agy_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Power & Notifications -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/agy_section_power_alerts"
            android:textColor="@color/agy_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/agy_card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <Switch
                android:id="@+id/switch_keep_screen_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/agy_switch_keep_screen_on"
                android:textColor="@color/agy_text_primary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/switch_cpu_wakelock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="false"
                android:text="@string/agy_switch_cpu_wakelock"
                android:textColor="@color/agy_text_primary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/switch_notify_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="@string/agy_switch_notify_done"
                android:textColor="@color/agy_text_primary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/switch_notify_foreground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="false"
                android:text="@string/agy_switch_notify_foreground"
                android:textColor="@color/agy_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sheet_btn_test_notif"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/agy_btn_secondary"
                    android:gravity="center"
                    android:text="@string/agy_btn_test_alert"
                    android:textColor="@color/agy_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sheet_btn_phantom_fix"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/agy_btn_secondary"
                    android:gravity="center"
                    android:text="@string/agy_btn_android12_fix"
                    android:textColor="@color/agy_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Offline Backup & Restore -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/agy_section_backup"
            android:textColor="@color/agy_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/agy_card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sheet_btn_backup_full"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/agy_btn_secondary"
                    android:gravity="center"
                    android:text="@string/agy_btn_backup_full"
                    android:textColor="@color/agy_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sheet_btn_backup_packages"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/agy_btn_secondary"
                    android:gravity="center"
                    android:text="@string/agy_btn_backup_packages"
                    android:textColor="@color/agy_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/sheet_btn_restore"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/agy_btn_primary"
                android:gravity="center"
                android:text="@string/agy_btn_restore_backup"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/sheet_backup_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/agy_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sheet_backup_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/agy_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>